# --- Gateway server ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# --- Client authentication ---
# Comma-separated API keys that clients must send as "Authorization: Bearer <key>".
# Leave empty to disable auth (local development only — not for production).
GATEWAY_API_KEYS=demo-key-123

# --- Rate limiting (requests per minute, per API key) ---
RATE_LIMIT_RPM=60

# --- Retry policy for provider calls ---
MAX_RETRIES=3
RETRY_BASE_DELAY=0.5

# --- Routing ---
# Default provider when no MODEL_ROUTES prefix matches the requested model.
DEFAULT_PROVIDER=mock
# Comma-separated "model-prefix:provider" pairs (longest prefix wins).
MODEL_ROUTES=mock:mock,gpt:openai,openai:openai

# --- OpenAI-compatible provider (OpenAI, Azure, OpenRouter, vLLM, Ollama...) ---
# Leave OPENAI_API_KEY empty to run fully offline on the mock provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
PROVIDER_TIMEOUT=60

# --- Storage ---
DATABASE_PATH=data/gateway.db
